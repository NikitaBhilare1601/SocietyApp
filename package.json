{
  "name": "society-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "bun --cwd backend run dev",
    "dev:frontend": "bun --cwd frontend run dev",
    "build:frontend": "cd frontend && bun compile.ts",
    "start": "bun --cwd backend run start"
  }
}
